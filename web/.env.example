# PostgreSQL is server-only. Never prefix these variables with NEXT_PUBLIC_.
DATABASE_URL=postgresql://market_engine_app@127.0.0.1:55432/market_engine_phase2r_a
# For a managed pooled endpoint, use a dedicated market_engine_app_login that
# inherits market_engine_app and set this to inherited_market_engine_app.
MARKET_ENGINE_DATABASE_ROLE=market_engine_app
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
MARKET_ENGINE_MODEL_VERSION=kr-v0.2.1
WORKBENCH_AUTH_MODE=local
WORKBENCH_ACCESS_SECRET=
WORKBENCH_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
WORKBENCH_DEFAULT_ACTOR_ID=00000000-0000-0000-0000-000000000002

# AI Research Worker. OPENAI_API_KEY is stored in .env.local, never committed.
OPENAI_RESEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6
OPENAI_RESEARCH_TIMEOUT_MS=240000
RESEARCH_POLL_INTERVAL_MS=1500
RESEARCH_RUNNING_LEASE_MS=300000
RESEARCH_CRON_MAX_JOBS=1
# Separate 32+ character secret for a scheduler calling the internal run-once route.
RESEARCH_WORKER_SECRET=
# Vercel Cron sends CRON_SECRET as a Bearer token; it is used only when
# RESEARCH_WORKER_SECRET is not configured.
CRON_SECRET=
